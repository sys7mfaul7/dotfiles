// User-level markdownlint-cli2 options (Emacs flycheck passes this with --config;
// a .markdownlint-cli2.jsonc / .markdownlint.jsonc inside a project still wins there).
// Keeps structural checks, drops style rules that flag almost every line of notes.
{
  "config": {
    "default": true,
    "MD013": false,                      // line length: prose and tables are long
    "MD041": false,                      // first line must be a top-level heading
    "MD033": false,                      // inline HTML (<br>, <b>, <details>) is fine
    "MD060": false,                      // table column/pipe alignment style
    "MD055": false,                      // leading/trailing table pipe style
    "MD058": false,                      // blank lines around tables
    "MD036": false,                      // **Bold line** used as a label
    "MD034": false,                      // bare URLs
    "MD026": false,                      // trailing punctuation in headings
    "MD024": { "siblings_only": true },  // duplicate headings only under the same parent
    "MD007": { "indent": 2 },
    "MD009": { "br_spaces": 2 }          // trailing spaces (two = hard line break is allowed)
  }
}
