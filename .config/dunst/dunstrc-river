[global]
    layer = overlay
    origin = top-center
    offset = (0, -34)
    width = 3440
    height = (34, 34)
    notification_limit = 1
    padding = 7
    horizontal_padding = 14
    frame_width = 0
    separator_height = 0
    corner_radius = 0
    gap_size = 0
    font = JetBrains Mono Bold 10.5
    markup = full
    format = "<b>%s</b>  %b"
    alignment = center
    vertical_alignment = center
    word_wrap = no
    ellipsize = end
    ignore_newline = yes
    show_indicators = no
    icon_position = off
    progress_bar = false
    background = "#000000"
    foreground = "#c0ffc0"
    mouse_left_click = close_current
    mouse_right_click = close_all
[urgency_low]
    background = "#000000"
    foreground = "#4f7f5a"
    timeout = 4
[urgency_normal]
    background = "#000000"
    foreground = "#c0ffc0"
    timeout = 6
[urgency_critical]
    background = "#000000"
    foreground = "#00ff41"
    timeout = 0
