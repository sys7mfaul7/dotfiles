#!/bin/sh
# raise|lower|normal — stacking via bspwm layers (most useful for floating windows).
export BSPWM_SOCKET="${BSPWM_SOCKET:-/run/user/1000/bspwmwayland-0_0_0-socket}"
id=$(bspc query -N -n focused.window) || exit 0
case "$1" in
raise)
  # above layer = top of stack among floats; tiled cannot leave normal layer
  if bspc query -N -n "$id.floating" >/dev/null 2>&1 || \
     bspc query -N -n "$id.fullscreen" >/dev/null 2>&1; then
    bspc node "$id" -l above
    bspc node -f "$id"
  fi
  ;;
lower)
  if bspc query -N -n "$id.floating" >/dev/null 2>&1 || \
     bspc query -N -n "$id.fullscreen" >/dev/null 2>&1; then
    bspc node "$id" -l below
  fi
  ;;
normal)
  bspc node "$id" -l normal 2>/dev/null || true
  ;;
*)
  echo "usage: wl-stack raise|lower|normal" >&2
  exit 2
  ;;
esac
