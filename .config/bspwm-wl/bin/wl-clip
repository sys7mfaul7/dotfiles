#!/bin/sh
# wl-clip : clipboard history picker (cliphist + bemenu); history fed by wl-paste --watch in autostart
sel=$(cliphist list | BEMENU_BACKEND=wayland bemenu -l 15 -p 'clip' -H 26 --fn 'JetBrains Mono Bold 11' --tb '#000000' --tf '#00ff41' \
  --fb '#000000' --ff '#c0ffc0' --nb '#000000' --nf '#c0ffc0' --hb '#1f6f2f' --hf '#c0ffc0' --ab '#000000' --af '#c0ffc0' -B 0) || exit 0
printf '%s' "$sel" | cliphist decode | wl-copy
