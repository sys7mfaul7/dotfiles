#!/bin/sh
# wl-eqcols [-r] [-n] : give every column on the focused desktop equal width,
# however many windows are stacked in each column.
#   -r  also give every row inside each column equal height
#   -n  dry run: print "node ratio" lines, change nothing
#   -d DESK  act on another desktop (default: focused)
# cols(leaf)=1, cols(vertical split)=sum, cols(horizontal split)=1: a stack is ONE
# column; vertical splits nested inside a stack are equalized within it.
# rows(horizontal split)=sum, rows(vertical split)=1 (mirror). Floating/hidden (vacant) count 0.
# Works with bspwm-wl and X11 bspwm (only needs bspc + jq).
rows=0; dry=0; desk=focused
while [ $# -gt 0 ]; do case "$1" in -r) rows=1;; -n) dry=1;; -d) desk=$2; shift;; esac; shift; done
bspc query -T -d "$desk" | jq -r --argjson rows "$rows" '
  def live: . != null and (.vacant | not) and (.hidden | not);
  def cols: if live | not then 0
    elif .firstChild == null then 1
    elif .splitType == "vertical" then (.firstChild|cols) + (.secondChild|cols)
    else 1 end;
  def rws: if live | not then 0
    elif .firstChild == null then 1
    elif .splitType == "horizontal" then (.firstChild|rws) + (.secondChild|rws)
    else 1 end;
  .root | recurse(.firstChild, .secondChild; . != null)
  | select(.firstChild != null and live)
  | if .splitType == "vertical" then
      ((.firstChild|cols) as $a | (.secondChild|cols) as $b
       | select($a > 0 and $b > 0) | "\(.id) \($a / ($a + $b))")
    elif $rows == 1 then
      ((.firstChild|rws) as $a | (.secondChild|rws) as $b
       | select($a > 0 and $b > 0) | "\(.id) \($a / ($a + $b))")
    else empty end' |
while read -r id r; do
  if [ "$dry" = 1 ]; then echo "$id $r"; else bspc node "$id" -r "$r"; fi
done
