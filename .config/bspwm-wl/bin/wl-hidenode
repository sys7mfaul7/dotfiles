#!/bin/sh
. "$HOME/.config/rices/current/ui.sh" 2>/dev/null   # RICE_SELECT_BG/FG: menu highlight of the active rice
# wl-hidenode --hide|--menu : port of HideNode (bspc + bemenu)
case "$1" in
--hide) bspc node focused.window -g hidden=on ;;
--menu) sel=$(for n in $(bspc query -N -n .hidden.window); do bspc query -T -n "$n" | jq -r '"\(.id)  \(.client.className)"'; done | \
          BEMENU_BACKEND=wayland bemenu -p 'HIDDEN' -H 22 --fn 'DejaVu Sans Mono, Symbols Nerd Font Mono 11' --tb '#000000' --tf "${RICE_MENU_TITLE:-#00ff41}" \
          --fb '#000000' --ff '#c0ffc0' --nb '#000000' --nf '#c0ffc0' --hb "${RICE_SELECT_BG:-#1f6f2f}" --hf "${RICE_SELECT_FG:-#c0ffc0}" --ab '#000000' --af '#c0ffc0' -B 0 --hp 8) || exit 0
        id=${sel%% *}; bspc node "$id" -d focused; bspc node "$id" -g hidden=off; bspc node -f "$id" ;;
esac
