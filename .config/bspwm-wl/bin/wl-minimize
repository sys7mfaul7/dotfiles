#!/bin/sh
# --- keep floating geometry across hide/show (no auto-centering) ---
G="${XDG_RUNTIME_DIR:-/tmp}/scratch-geo"; mkdir -p "$G"
geo_get() { bspc query -T -n "$1" 2>/dev/null | jq -r ".client.floatingRectangle | \"\(.x) \(.y) \(.width) \(.height)\""; }
geo_save() { r=$(geo_get "$1") && [ -n "$r" ] && echo "$r" >"$G/$1"; return 0; }
geo_restore() {
  [ -s "$G/$1" ] || return 0
  set -- "$1" $(cat "$G/$1") $(geo_get "$1")
  [ $# -eq 9 ] || return 0
  bspc node "$1" -v $(($2-$6)) $(($3-$7)) 2>/dev/null
  bspc node "$1" -z bottom_right $(($4-$8)) $(($5-$9)) 2>/dev/null; return 0
}
# Minimize tray on desktop M. Super+M:
#   - if tray windows are shown on this desktop -> hide them back to M
#   - else if tray has windows -> show them on the current desktop (floating)
#   - else -> minimize the focused window onto M
export BSPWM_SOCKET="${BSPWM_SOCKET:-/run/user/1000/bspwmwayland-0_0_0-socket}"
L="${XDG_RUNTIME_DIR:-/tmp}/bspwm-wl-minimize"
# serialize rapid presses; give up after 1s so a stuck lock can't wedge the key
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/bspwm-wl-minimize.lock"; flock -w 1 9 || exit 0
touch "$L"
tmp=$(mktemp)
while read -r id; do
  bspc query -N -n "$id" >/dev/null 2>&1 && echo "$id"
done <"$L" | awk '!s[$0]++' >"$tmp"
mv "$tmp" "$L"

# Ensure holding desktop exists (after numbered ones)
bspc query -D --names | grep -qx M || bspc monitor focused -a M

# "shown" = shown on the FOCUSED desktop (shown elsewhere -> bring here)
here=$(bspc query -N -d focused -n '.!hidden.window')
shown=0
while read -r id; do
  printf '%s\n' "$here" | grep -qx "$id" && shown=1
done <"$L"

hide_all() {
  while read -r id; do
    geo_save "$id"; bspc node "$id" -d M
    bspc node "$id" -t floating
    bspc node "$id" -g hidden=on
  done <"$L"
}

show_all() {
  d=$(bspc query -D -d focused)
  while read -r id; do
    bspc node "$id" -d "$d"
    bspc node "$id" -g hidden=off
    bspc node "$id" -t floating
    bspc node -f "$id"
    geo_restore "$id"
  done <"$L"
}

minimize_focused() {
  id=$(bspc query -N -n focused.window) || return 1
  grep -qx "$id" "$L" || echo "$id" >>"$L"
  bspc node "$id" -t floating
  geo_save "$id"; bspc node "$id" -d M
  bspc node "$id" -g hidden=on
}

if [ "$shown" = 1 ]; then
  hide_all
elif [ -s "$L" ]; then
  show_all
else
  minimize_focused || dunstify -t 1500 "Minimize" "empty — focus a window first"
fi
