# bspwm-wl app rules (Omarchy-style: one line per app). Read by bspwmrc at login/reload.
# Format:  <app-id or Class[:instance]>  key=value ...
#   any `bspc rule` key: state=floating|tiled|pseudo_tiled|fullscreen  desktop=^N  center=on
#   focus=on  sticky=on  follow=on  layer=above  split_dir=...  border=off  locked=on
#   size=WxH (pixels) or size=W%xH% (of the focused monitor) -> rectangle
#   opacity=0.9  (accepted but ignored: bspwm-wl has no per-window opacity yet;
#                 terminals get transparency from foot's colors-dark.alpha instead)
# Find an app-id: bspc query -T -n focused | jq -r .client.className
#
