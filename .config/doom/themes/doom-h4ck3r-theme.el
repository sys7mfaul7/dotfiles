;;; doom-h4ck3r-theme.el --- green-on-black matrix theme -*- lexical-binding: t; no-byte-compile: t; -*-
;;
;; Palette: bg #000000, text #c0ffc0, accent #00ff41, selection #1f6f2f,
;; dim/comments #4f7f5a, secondary/icons #578a29. No blue anywhere.
;;
(require 'doom-themes)

(defgroup doom-h4ck3r-theme nil
  "Options for the `doom-h4ck3r' theme."
  :group 'doom-themes)

(def-doom-theme doom-h4ck3r
  "Green-on-black matrix theme (no blue)."
  :family 'doom-h4ck3r
  :background-mode 'dark

  ;; name        default    256        16
  ((bg         '("#000000" "black"    "black"))
   (fg         '("#c0ffc0" "#c0ffc0"  "brightgreen"))
   (bg-alt     '("#040a05" "black"    "black"))
   (fg-alt     '("#8fcf9a" "#8fcf9a"  "green"))

   (base0      '("#000000" "black"    "black"))
   (base1      '("#030803" "#080808"  "brightblack"))
   (base2      '("#071208" "#121212"  "brightblack"))
   (base3      '("#0c1f10" "#1c1c1c"  "brightblack"))
   (base4      '("#1f3f26" "#303030"  "brightblack"))
   (base5      '("#4f7f5a" "#5f875f"  "brightblack"))
   (base6      '("#6f9f7a" "#87af87"  "brightblack"))
   (base7      '("#9fcfaa" "#afd7af"  "green"))
   (base8      '("#c0ffc0" "#d7ffd7"  "brightgreen"))

   (grey       base5)
   (red        '("#ff3b3b" "#ff5f5f"  "red"))
   (orange     '("#b6ff5a" "#afff5f"  "brightgreen"))
   (green      '("#00ff41" "#00ff5f"  "green"))
   (teal       '("#3fdf7f" "#5fd787"  "green"))
   (yellow     '("#d4ff6a" "#d7ff5f"  "yellow"))
   ;; "blue" slots are remapped to greens on purpose
   (blue       '("#00d936" "#00d75f"  "green"))
   (dark-blue  '("#1f6f2f" "#005f00"  "green"))
   (magenta    '("#7dff9e" "#87ffaf"  "brightgreen"))
   (violet     '("#5fdf8a" "#5fd787"  "green"))
   (cyan       '("#39ff88" "#5fff87"  "brightgreen"))
   (dark-cyan  '("#2fae5a" "#00af5f"  "green"))

   (accent     green)
   (icons      '("#578a29" "#5f8700"  "green"))
   (dim        base5)

   (highlight      accent)
   (vertical-bar   base3)
   (selection      dark-blue)
   (builtin        cyan)
   (comments       dim)
   (doc-comments   (doom-lighten dim 0.2))
   (constants      orange)
   (functions      accent)
   (keywords       cyan)
   (methods        teal)
   (operators      fg-alt)
   (type           yellow)
   (strings        magenta)
   (variables      fg)
   (numbers        orange)
   (region         '("#1f6f2f" "#005f00" "green"))
   (error          red)
   (warning        yellow)
   (success        accent)
   (vc-modified    icons)
   (vc-added       accent)
   (vc-deleted     red)

   (modeline-fg          fg)
   (modeline-fg-alt      dim)
   (modeline-bg          base2)
   (modeline-bg-inactive base1)
   ;; active-window look (rice-mapped; matches nvim act/nc/StatusLine)
   (win-act    "#000a03")
   (win-nc     "#000001")
   (win-cl     "#0f1a14")
   (ml-act-fg  "#000000")
   (ml-act-bg  "#00ff41")
   (ml-nc-fg   "#00ff42")
   (ml-nc-bg   "#0f1a15"))

  ;;;; Face overrides
  ((default :background win-act :foreground fg)
   (cursor :background accent)
   (fringe :background win-act :foreground dim)
   (link :foreground accent :underline t :weight 'bold)
   (link-visited :foreground icons :underline t)
   (minibuffer-prompt :foreground accent :weight 'bold)
   (region :background region :foreground 'unspecified :extend t)
   (hl-line :background win-cl :extend t)
   (highlight :background dark-blue :foreground fg)
   (show-paren-match :foreground bg :background accent :weight 'bold)
   (isearch :foreground bg :background accent :weight 'bold)
   (lazy-highlight :foreground fg :background dark-blue)
   ((line-number &override) :foreground dim :background win-act)
   ((line-number-current-line &override) :foreground accent :background win-cl :weight 'bold)
   (vertical-border :foreground base4 :background bg)
   (window-divider :foreground base4)
   (font-lock-keyword-face :foreground keywords :weight 'bold)
   (font-lock-function-name-face :foreground functions :weight 'bold)
   (font-lock-comment-face :foreground comments :slant 'italic)
   (font-lock-doc-face :foreground doc-comments :slant 'italic)
   (shadow :foreground dim)
   (tooltip :background base2 :foreground fg)
   (header-line :background base2 :foreground fg)
   (tab-bar :background base1 :foreground dim)
   (tab-line :background base1 :foreground dim)

   ;;;; mode-line / doom-modeline
   (mode-line :background ml-act-bg :foreground ml-act-fg :weight 'bold :box `(:line-width 1 :color ,ml-act-bg))
   (mode-line-active :inherit 'mode-line)
   (mode-line-inactive :background ml-nc-bg :foreground ml-nc-fg :weight 'normal :box `(:line-width 1 :color ,ml-nc-bg))
   (auto-dim-other-buffers-face :background win-nc)
   (auto-dim-other-buffers-hide-face :foreground win-nc :background win-nc)
   (mode-line-emphasis :foreground ml-act-fg :weight 'bold)
   (mode-line-highlight :foreground ml-act-fg)
   (mode-line-buffer-id :foreground ml-act-fg :weight 'bold)
   ;; active mode line: everything dark on accent (doom-modeline only uses these in the active window)
   (doom-modeline :foreground ml-act-fg)
   (doom-modeline-emphasis :foreground ml-act-fg :weight 'bold)
   (doom-modeline-notification :foreground ml-act-fg :weight 'bold :underline t)
   (doom-modeline-lsp-warning :foreground ml-act-fg :weight 'bold :underline t)
   (doom-modeline-lsp-error :foreground ml-act-fg :weight 'bold :underline '(:style wave))
   (doom-modeline-lsp-running :foreground ml-act-fg)
   (doom-modeline-buffer-timemachine :foreground ml-act-fg :slant 'italic)
   (doom-modeline-input-method :foreground ml-act-fg)
   (doom-modeline-debug :foreground ml-act-fg :underline t)
   (doom-modeline-battery-normal :foreground ml-act-fg)
   (doom-modeline-time :foreground ml-act-fg)
   (doom-modeline-bar :background ml-act-fg)
   (doom-modeline-bar-inactive :background base3)
   (doom-modeline-buffer-file :foreground ml-act-fg :weight 'bold)
   (doom-modeline-buffer-path :foreground ml-act-fg :weight 'bold)
   (doom-modeline-buffer-major-mode :foreground ml-act-fg :weight 'bold)
   (doom-modeline-buffer-minor-mode :foreground ml-act-fg)
   (doom-modeline-buffer-modified :foreground ml-act-fg :weight 'bold :slant 'italic)
   (doom-modeline-project-dir :foreground ml-act-fg :weight 'bold)
   (doom-modeline-project-root-dir :foreground ml-act-fg)
   (doom-modeline-buffer-project-root :foreground ml-act-fg :weight 'bold)
   (doom-modeline-info :foreground ml-act-fg)
   (doom-modeline-warning :foreground ml-act-fg :weight (quote bold) :underline t)
   (doom-modeline-urgent :foreground ml-act-fg :weight (quote bold) :underline (quote (:style wave)))
   (doom-modeline-lsp-success :foreground ml-act-fg)
   (doom-modeline-persp-name :foreground ml-act-fg)
   (doom-modeline-evil-normal-state :foreground ml-act-fg)
   (doom-modeline-evil-insert-state :foreground ml-act-fg)
   (doom-modeline-evil-visual-state :foreground ml-act-fg)
   (doom-modeline-evil-emacs-state :foreground ml-act-fg)
   (doom-modeline-evil-motion-state :foreground ml-act-fg)
   (doom-modeline-evil-replace-state :foreground ml-act-fg)
   (doom-modeline-evil-operator-state :foreground ml-act-fg)

   ;;;; dashboard
   (doom-dashboard-banner :foreground accent)
   (doom-dashboard-loaded :foreground dim)
   (doom-dashboard-menu-title :foreground accent :weight 'bold)
   (doom-dashboard-menu-desc :foreground icons)
   (doom-dashboard-footer :foreground dim)
   (doom-dashboard-footer-icon :foreground icons)

   ;;;; completion (vertico/orderless/marginalia/consult)
   (vertico-current :background dark-blue :foreground fg :weight 'bold :extend t)
   (orderless-match-face-0 :foreground accent :weight 'bold)
   (orderless-match-face-1 :foreground cyan :weight 'bold)
   (orderless-match-face-2 :foreground yellow :weight 'bold)
   (orderless-match-face-3 :foreground teal :weight 'bold)
   (completions-common-part :foreground accent)
   (marginalia-documentation :foreground dim)
   (consult-file :foreground fg)

   ;;;; which-key / evil / misc
   (which-key-key-face :foreground accent)
   (which-key-group-description-face :foreground icons)
   (which-key-command-description-face :foreground fg)
   (which-key-local-map-description-face :foreground cyan)
   (evil-ex-substitute-matches :background red :foreground bg)
   (evil-ex-substitute-replacement :background accent :foreground bg)
   (button :foreground accent :underline t)
   (info-xref :foreground accent :underline t)
   (help-key-binding :foreground accent :background base2 :box `(:line-width 1 :color ,base4))
   (dired-directory :foreground accent :weight 'bold)
   (diredfl-dir-name :foreground accent :weight 'bold)
   (hl-todo :foreground yellow :weight 'bold)
   (popup-tip-face :background base2 :foreground fg)
   (company-tooltip :background base2 :foreground fg)
   (company-tooltip-selection :background dark-blue :foreground fg)
   (corfu-default :background base2 :foreground fg)
   (corfu-current :background dark-blue :foreground fg)

   ;;;; org
   (org-level-1 :foreground accent :weight 'bold :height 1.15)
   (org-level-2 :foreground cyan :weight 'bold)
   (org-level-3 :foreground teal :weight 'bold)
   (org-level-4 :foreground magenta :weight 'bold)
   (org-level-5 :foreground icons :weight 'bold)
   (org-level-6 :foreground violet :weight 'bold)
   (org-level-7 :foreground dark-cyan :weight 'bold)
   (org-level-8 :foreground fg-alt :weight 'bold)
   (org-document-title :foreground accent :weight 'bold :height 1.3)
   (org-document-info :foreground fg-alt)
   (org-link :foreground accent :underline t)
   (org-date :foreground icons)
   (org-todo :foreground accent :weight 'bold)
   (org-done :foreground dim :weight 'bold)
   (org-block :background base1 :extend t)
   (org-block-begin-line :foreground dim :background base1 :extend t)
   (org-block-end-line :foreground dim :background base1 :extend t)
   (org-code :foreground magenta)
   (org-verbatim :foreground cyan)
   (org-tag :foreground icons)
   (org-special-keyword :foreground dim)
   (org-table :foreground fg-alt)

   ;;;; markdown
   (markdown-header-face :inherit 'bold :foreground accent)
   (markdown-link-face :foreground accent :underline t)
   (markdown-url-face :foreground icons)

   ;;;; stray built-in faces that default to blue/purple
   (org-clock-overlay :background dark-blue :foreground fg)
   (transient-key-recurse :foreground cyan)
   (edmacro-label :foreground cyan)
   (elisp-rx :foreground magenta)
   (elisp-symbol-role-definition :foreground functions :weight 'bold)
   (elisp-symbol-role :foreground teal)
   (tty-menu-disabled-face :background base3 :foreground dim)
   (tty-menu-enabled-face :background dark-blue :foreground fg)

   ;;;; nerd-icons (all secondary icon green)
   (nerd-icons-red :foreground icons)
   (nerd-icons-lred :foreground icons)
   (nerd-icons-dred :foreground icons)
   (nerd-icons-green :foreground icons)
   (nerd-icons-lgreen :foreground icons)
   (nerd-icons-dgreen :foreground icons)
   (nerd-icons-yellow :foreground icons)
   (nerd-icons-lyellow :foreground icons)
   (nerd-icons-dyellow :foreground icons)
   (nerd-icons-blue :foreground icons)
   (nerd-icons-lblue :foreground icons)
   (nerd-icons-dblue :foreground icons)
   (nerd-icons-maroon :foreground icons)
   (nerd-icons-lmaroon :foreground icons)
   (nerd-icons-dmaroon :foreground icons)
   (nerd-icons-purple :foreground icons)
   (nerd-icons-lpurple :foreground icons)
   (nerd-icons-dpurple :foreground icons)
   (nerd-icons-orange :foreground icons)
   (nerd-icons-lorange :foreground icons)
   (nerd-icons-dorange :foreground icons)
   (nerd-icons-cyan :foreground icons)
   (nerd-icons-lcyan :foreground icons)
   (nerd-icons-dcyan :foreground icons)
   (nerd-icons-pink :foreground icons)
   (nerd-icons-lpink :foreground icons)
   (nerd-icons-dpink :foreground icons)
   (nerd-icons-silver :foreground icons)
   (nerd-icons-lsilver :foreground icons)
   (nerd-icons-dsilver :foreground icons)
   (nerd-icons-red-alt :foreground icons)
   (nerd-icons-blue-alt :foreground icons)
   (nerd-icons-purple-alt :foreground icons)
   (nerd-icons-cyan-alt :foreground icons))

  ;;;; Variable overrides
  ())

;;; doom-h4ck3r-theme.el ends here
