#!/bin/sh
# theme-apply : turn ~/.config/bspwm/theme into the files other programs read.
# part of sys7mfaul7 dotfiles
# Writes ~/.config/bspwm/generated/{theme.rasi,polybar.ini,dunstrc,xsettingsd,jgmenurc}.
# Safe to run any time; it only touches the generated/ folder.
B="$HOME/.config/bspwm"
. "$B/theme"
G="$B/generated"
mkdir -p "$G"

# write via a temp file so a reader never sees half a file
put() { t=$(mktemp "$G/.new.XXXXXX") && cat >"$t" && mv -f "$t" "$G/$1"; }

DPI=$(cat "$HOME/.cache/display-dpi" 2>/dev/null || echo 96)
# pango font strings: "Family, Icon family [Style] size"; Book/Regular is
# pango's default weight, so it is left out rather than spelled.
case $FONT_STYLE in Book|Regular|"") PS="" ;; *) PS="$FONT_STYLE " ;; esac
PF="$FONT_FAMILY, $ICON_FONT $PS"            # text + icon fallback
CUR=$CURSOR_SIZE; [ "$CUR" = auto ] && CUR=$((24 * DPI / 96))

put theme.rasi <<RASI
/* generated by theme-apply from ~/.config/bspwm/theme - do not edit */
configuration { dpi: $DPI; }
* {
    bg: $C_BG; bg-alt: $C_BG_ALT; fg: $C_FG; accent: $C_ACCENT;
    sel-bg: $C_SEL; sel-fg: $C_FG; dim: $C_DIM; urgent: $C_URGENT;
    font: "$PF$FONT_SIZE";
    font-emph: "$FONT_FAMILY, $ICON_FONT $FONT_EMPH_STYLE $FONT_SIZE";
}
RASI

put polybar.ini <<PB
; generated by theme-apply from ~/.config/bspwm/theme - do not edit
[theme]
bg     = $C_BG
fg     = $C_FG
accent = $C_ACCENT
sel    = $C_SEL
dim    = $C_DIM
urgent = $C_URGENT
height = ${BAR_HEIGHT_PT}pt
font-text     = $FONT_FAMILY:style=$FONT_STYLE:size=$FONT_SIZE;1
font-emph     = $FONT_FAMILY:style=$FONT_EMPH_STYLE:size=$FONT_SIZE;1
font-icon     = $ICON_FONT:size=$((FONT_SIZE - 1));2
font-icon-big = $ICON_FONT:size=$((FONT_SIZE + 2));3
PB

put dunstrc <<DUNST
# generated by theme-apply from ~/.config/bspwm/theme - do not edit
[global]
    monitor = 0
    follow = mouse
    origin = top-center
    offset = (0, 34)
    width = (300, 420)
    notification_limit = 8
    gap_size = 4
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "$C_ACCENT"
    separator_color = frame
    corner_radius = 0
    scale = 0
    font = $PF$((FONT_SIZE - 1))
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 48
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    highlight = "$C_ACCENT"
    history_length = 30
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "$C_BG"
    foreground = "$C_DIM"
    timeout = 3

[urgency_normal]
    background = "$C_BG"
    foreground = "$C_FG"
    timeout = 5

[urgency_critical]
    background = "$C_BG"
    foreground = "$C_URGENT"
    frame_color = "$C_URGENT"
    timeout = 0
DUNST

put xsettingsd <<XS
Net/ThemeName "$GTK_THEME_NAME"
Net/IconThemeName "$ICON_THEME"
Gtk/CursorThemeName "$CURSOR_THEME"
Gtk/CursorThemeSize $CUR
Gtk/FontName "$FONT_FAMILY $PS$FONT_SIZE"
Gtk/DecorationLayout ":"
Xft/DPI $((DPI * 1024))
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintslight"
Xft/RGBA "none"
XS

put jgmenurc <<JG
# generated by theme-apply from ~/.config/bspwm/theme - do not edit
position_mode = pointer
stay_alive = 0
terminal_exec = $TERMINAL
terminal_args = -e
menu_width = 220
menu_padding_top = 4
menu_padding_right = 4
menu_padding_bottom = 4
menu_padding_left = 4
menu_radius = 0
menu_border = 1
item_height = 24
item_padding_x = 8
item_radius = 0
sep_height = 1
font = $PF$FONT_SIZE
icon_size = 0
color_menu_bg = $C_BG 100
color_menu_border = $C_ACCENT 100
color_norm_bg = $C_BG 0
color_norm_fg = $C_FG 100
color_sel_bg = $C_SEL 100
color_sel_fg = $C_FG 100
color_sep_fg = $C_DIM 100
JG
