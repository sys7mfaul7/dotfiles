#!/bin/sh
# dpi : pick a font DPI for the X11 session from the primary monitor's size
# part of sys7mfaul7 dotfiles
#   dpi          print the DPI it would use
#   dpi apply    also load it: Xft.* resources, ~/.cache/display-dpi,
#                generated/xsettingsd (GTK), cursor size; prints the DPI
# Override: a number in ~/.config/bspwm/dpi, or BSPWM_DPI in the environment.
#
# How the number is chosen:
#   physical = horizontal pixels / (width in mm / 25.4)   (from xrandr)
#   screens under 18" diagonal (laptops) are viewed closer, so x0.6
#   then rounded to a multiple of 24 and kept within 96..288.
# 96 DPI is the reference: 11pt text = ~15px, the bar = 26px.
B="$HOME/.config/bspwm"

pick() {
    o=${BSPWM_DPI:-$(tr -dc 0-9 2>/dev/null <"$B/dpi")}
    [ -n "$o" ] && { echo "$o"; return; }
    xrandr --query 2>/dev/null | awk '
        / connected/ {
            px=0; mw=0; mh=0
            for (i=1;i<=NF;i++) {
                if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i,a,/[x+]/); px=a[1] }
                if ($i ~ /^[0-9]+mm$/ && mw==0) { mw=$i+0; mh=$(i+2)+0 }
            }
            if (px>0 && (!found || $3=="primary")) { P=px; W=mw; H=mh; found=1 }
        }
        END {
            if (!found || W<=0) { print 96; exit }
            raw = P * 25.4 / W
            diag = sqrt(W*W + H*H) / 25.4
            if (diag < 18) raw *= 0.6
            d = int(raw/24 + 0.5) * 24
            if (d < 96) d = 96; if (d > 288) d = 288
            print d
        }'
}

D=$(pick)
[ "$1" = apply ] || { echo "$D"; exit 0; }

. "$B/theme"
cur=$CURSOR_SIZE; [ "$cur" = auto ] && cur=$((24 * D / 96))
xrdb -merge <<XR
Xft.dpi: $D
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: none
Xft.lcdfilter: lcddefault
Xcursor.theme: $CURSOR_THEME
Xcursor.size: $cur
XR
mkdir -p "$HOME/.cache"; echo "$D" >"$HOME/.cache/display-dpi"
xs="$B/generated/xsettingsd"
[ -f "$xs" ] && sed -i "s|^Xft/DPI .*|Xft/DPI $((D * 1024))|; s|^Gtk/CursorThemeSize .*|Gtk/CursorThemeSize $cur|" "$xs" &&
    pkill -HUP -x xsettingsd
echo "$D"
