#!/bin/sh
# ~/.config/bspwm/bspwmrc : X11 bspwm session
# part of sys7mfaul7 dotfiles
#
# Layout of ~/.config/bspwm:
#   theme       fonts, colours, gaps   (the one file to edit for looks)
#   sxhkdrc     every key binding
#   scripts/    helpers the bindings and bar call
#   polybar/    bar config     rofi/  menu themes     jgmenu/  desktop menu
#   generated/  written by scripts/theme-apply (not in git)

B="$HOME/.config/bspwm"

# ---- environment ----------------------------------------------------------
set -a                       # export everything from the theme file
. "$B/theme"
set +a
export PATH="$B/scripts:$HOME/.local/bin:$PATH"
# qutebrowser: let Guix python see pip --user adblock
export PYTHONPATH="$HOME/.local/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export XDG_CURRENT_DESKTOP=bspwm
export SAL_USE_VCLPLUGIN=gtk3
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_AUTO_SCREEN_SCALE_FACTOR=0 QT_ENABLE_HIGHDPI_SCALING=0
export GTK_THEME="$GTK_THEME_NAME"
export _JAVA_AWT_WM_NONREPARENTING=1

# ---- input ----------------------------------------------------------------
xrdb -merge "$HOME/.Xresources"
xset r rate 220 45
xmodmap -e "pointer = 3 2 1"           # left-handed mouse buttons
xsetroot -cursor_name left_ptr

# ---- monitors and desktops ------------------------------------------------
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true
monitors                               # xrandr modes + desktops 1-10
[ -x "$HOME/.local/bin/display-auto" ] && "$HOME/.local/bin/display-auto"  # preferred modes for known screens

# ---- DPI: fonts are in points, so everything scales from this one number
XFT_DPI=$(dpi apply)                   # Xft.dpi from the monitor size (scripts/dpi)
theme-apply                            # write generated/ (rofi, dunst, GTK, jgmenu) at that DPI
[ "$CURSOR_SIZE" = auto ] && CURSOR_SIZE=$((24 * XFT_DPI / 96))
BAR_HEIGHT_PX=$(awk -v p="$BAR_HEIGHT_PT" -v d="$XFT_DPI" 'BEGIN{printf "%d", p*d/72 + 0.5}')
TOP_PADDING=$((BAR_HEIGHT_PX + BAR_GAP_PX))
export XFT_DPI CURSOR_SIZE BAR_HEIGHT_PX TOP_PADDING
export QT_FONT_DPI="$XFT_DPI"          # Qt5/6 follow this instead of scaling
export XCURSOR_THEME="$CURSOR_THEME" XCURSOR_SIZE="$CURSOR_SIZE"
# hidden "M" desktop used by Super+M (minimize tray)
bspc query -D --names | grep -qx M || bspc monitor focused -a M

# ---- look -----------------------------------------------------------------
bspc config border_width         "$BORDER_WIDTH"
bspc config normal_border_color  "$BORDER_NORMAL"
bspc config active_border_color  "$BORDER_NORMAL"
bspc config focused_border_color "$BORDER_FOCUSED"
bspc config presel_feedback_color "$C_SEL"
bspc config window_gap           "$WINDOW_GAP"
bspc config top_padding          "$TOP_PADDING"
bspc config bottom_padding       "$SIDE_PADDING"
bspc config left_padding         "$SIDE_PADDING"
bspc config right_padding        "$SIDE_PADDING"

# ---- tiling ---------------------------------------------------------------
bspc config split_ratio        0.51
bspc config single_monocle     true
bspc config automatic_scheme   longest_side
bspc config initial_polarity   second_child
bspc config removal_adjustment true
bspc config external_rules_command "$B/scripts/rules"

# ---- focus and mouse (Super + drag: 1 move, 2 resize side, 3 resize corner)
bspc config focus_follows_pointer   true
bspc config pointer_follows_focus   false
bspc config pointer_follows_monitor true
bspc config pointer_motion_interval 7
bspc config pointer_modifier mod4
bspc config pointer_action1  move
bspc config pointer_action2  resize_side
bspc config pointer_action3  resize_corner
bspc config raise_floating_on_click true 2>/dev/null || true   # newer bspwm only

# ---- background services --------------------------------------------------
once() { pgrep -x "$1" >/dev/null || "$@" & }

# BSPWM_TEST=1 (headless test on a spare X display): only bar, keys, wallpaper
if [ -n "$BSPWM_TEST" ]; then
    sxhkd -c "$B/sxhkdrc" &
    bar start
    wallpaper-restore
    exit 0
fi

once sxhkd -c "$B/sxhkdrc"
once xsettingsd --config="$B/generated/xsettingsd"
pgrep -x dunst >/dev/null || dunst -config "$B/generated/dunstrc" &
command -v picom >/dev/null && ! pgrep -x picom >/dev/null && picom --config "$B/picom.conf" &
bar start
wallpaper-restore

# polkit agent
for p in "$HOME/.guix-profile" /run/current-system/profile; do
    a="$p/libexec/polkit-gnome-authentication-agent-1"
    [ -x "$a" ] && { pgrep -f "[p]olkit-gnome-authentication-agent-1" >/dev/null || "$a" & break; }
done
# removable media automount
command -v udiskie >/dev/null && ! pgrep -f "[u]diskie" >/dev/null &&
    udiskie --automount --notify --smart-tray >/dev/null 2>&1 &
# torrents (manage with tremc)
command -v transmission-daemon >/dev/null && ! pgrep -x transmission-da >/dev/null &&
    transmission-daemon -w "$HOME/Downloads/torrents" >/dev/null 2>&1
# local LLM server for Neovim
[ -x "$HOME/.local/bin/llm-serve" ] && "$HOME/.local/bin/llm-serve" &
# clipboard history (Super+V)
pgrep -x clipmenud >/dev/null || clipmenud &
# KeePassXC = Secret Service keyring (org.freedesktop.secrets), starts minimized to the tray
command -v keepassxc >/dev/null && ! pgrep -x .keepassxc-real >/dev/null && ! pgrep -x keepassxc >/dev/null &&
    setsid -f keepassxc --minimized >/dev/null 2>&1 </dev/null
# coloured borders for pinned windows
pgrep -f "[b]sp-pin-borders" >/dev/null || setsid -f "$HOME/.local/bin/bsp-pin-borders" >/dev/null 2>&1
