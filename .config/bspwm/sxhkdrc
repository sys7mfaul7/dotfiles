# ~/.config/bspwm/sxhkdrc : keyboard bindings for the X11 bspwm session
# part of sys7mfaul7 dotfiles
#
# Layout of this file: a "# text" line right above a key line is the help text
# shown by Super+F1 (scripts/keyhelp). Scripts named without a path live in
# ~/.config/bspwm/scripts (bspwmrc puts it first on PATH); helpers shared with
# the Wayland session live in ~/.local/bin and ~/.config/bspwm-wl/bin.

# ======================================================================
#  launching
# ======================================================================

# terminal (shift: floating)
super + {_,shift + }t
    term {_,--float}

# plain xterm (shift: floating)
super + ctrl + {_,shift + }t
    xterm {_,-class FloaTerm}

# pick which terminal to open
super + alt + t
    term --pick

# app launcher (one-line menu at the top)
super + space
    launcher drun

# run a command
super + ctrl + space
    launcher run

# chromium (shift: floating)
super + {_,shift + }b
    {_,bspc rule -a Chromium -o state=floating center=on && }chromium

# qutebrowser (shift: floating)
super + ctrl + {_,shift + }b
    {_,bspc rule -a qutebrowser -o state=floating center=on && }qutebrowser

# zed (shift: floating 1600x900)
super + e
    zed
super + shift + e
    bspc rule -a dev.zed.Zed -o state=floating center=on rectangle=1600x900+0+0; zed

# emacs (shift: floating)
super + ctrl + {_,shift + }e
    {_,bspc rule -a Emacs -o state=floating center=on && }emacs

# neovim in xterm (shift: floating)
super + {_,shift + }n
    xterm {_,-name NvimTerm -class FloaTerm }-e nvim

# nnn in a floating terminal
super + y
    xterm -name YaziTerm -class FloaTerm -e nnn

# vifm (shift: floating, ctrl: as root)
super + {_,shift + ,ctrl + ,ctrl + shift + }d
    ~/.local/bin/fm-term vifm {tiled user,float user,tiled sudo,float sudo}

# nnn (shift: floating, ctrl: as root)
super + alt + {_,shift + ,ctrl + ,ctrl + shift + }d
    ~/.local/bin/fm-term nnn {tiled user,float user,tiled sudo,float sudo}

# qalculate (floating)
super + q
    bspc rule -a Qalculate-gtk -o state=floating center=on && qalculate-gtk

# volume mixer
super + alt + v
    pavucontrol

# drop-down scratch terminal
super + alt + o
    scratchterm

# ======================================================================
#  menus and tools
# ======================================================================

# show this list
super + F1
    keyhelp

# calculator (bc)
super + c
    ~/.local/bin/rofi-calc

# emoji picker
super + shift + grave
    ~/.local/bin/rofi-emoji

# clipboard history
super + {v,alt + c}
    CM_LAUNCHER=rofi clipmenu -p clip -theme ~/.config/bspwm/rofi/dmenu.rasi

# colour picker
super + slash
    ~/.local/bin/colorpick

# wallpaper picker
super + alt + w
    wallselect

# wallpaper on / plain black
super + ctrl + w
    ~/.config/bspwm-wl/bin/wl-wallpaper toggle

# screenshot menu
super + alt + s
    screenshot menu

# screenshot: area / whole screen (saved and copied)
{_,shift + }Print
    screenshot {area,full}

# flameshot
super + Print
    flameshot gui

# network (nmtui)
super + alt + n
    bartui network

# bluetooth
super + alt + b
    bartui bluetooth

# mount an Android phone
super + alt + a
    android-mount

# keyboard layout
super + alt + k
    kbd-layout

# password store
super + alt + x
    pass-menu

# power menu
super + alt + p
    power-menu

# desktop right-click menu
~button3
    menu-on-desktop

# ======================================================================
#  session
# ======================================================================

# poweroff / reboot / log out / lock / xkill / reload the session
ctrl + super + alt + {p,Delete,q,l,k,s}
    {loginctl poweroff,loginctl reboot,bspc quit,lock,xkill,reload}

# log out
ctrl + alt + q
    bspc quit

# reload key bindings
super + Escape
    pkill -USR1 -x sxhkd && dunstify -u low -r 9001 sxhkd "key bindings reloaded"

# hide / show the bar
super + alt + {h,u}
    bar {hide,show}

# screen off now (any input wakes it)
ctrl + alt + l
    sleep 0.6; xset dpms force off

# opacity of the focused window: less / more / reset
ctrl + alt + {plus,minus,t}
    picom-trans {-c -3,-c +3,-c -d}

# toggle opacity of the focused window
super + o
    ~/.local/bin/bsp-opacity

# brightness
XF86MonBrightness{Up,Down}
    ~/.local/bin/sys-brightness {up,down}

# volume
XF86Audio{RaiseVolume,LowerVolume,Mute}
    ~/.local/bin/sys-volume {up,down,mute}

# media player
XF86Audio{Next,Prev,Play,Stop}
    ~/.local/bin/sys-media {next,prev,toggle,stop}

# ======================================================================
#  windows
# ======================================================================

# close / kill
super + {_,shift + }x
    bspc node -{c,k}

# close / kill (respects a marked selection)
super + {_,shift + }w
    ~/.local/bin/bspwm-sel {close,kill}

# close every window on this desktop
super + shift + alt + w
    for w in $(bspc query -N -d -n .window); do bspc node "$w" -c; done

# then x: close, k: kill all other windows here
super + n ; {x,k}
    for w in $(bspc query -N -n .local.window.!focused.!marked); do bspc node "$w" -{c,k}; done

# then m: pull all marked windows here
super + n ; m
    for w in $(bspc query -N -n .marked); do bspc node "$w" -d focused --follow; done

# then 1-9: pull every window from that desktop here
super + n ; {1-9}
    for w in $(bspc query -N -d ^{1-9} -n .window); do bspc node "$w" -d focused; done

# floating toggle
super + f
    ~/.local/bin/bspwm-sel float

# fullscreen toggle
super + shift + f
    bspc node -t ~fullscreen

# pin on all desktops
super + p
    ~/.local/bin/bspwm-sel pin

# picture-in-picture (alt: bigger)
super + shift + {_,alt + }p
    ~/.local/bin/bsp-pip {_,--big}

# minimize to the hidden M desktop
super + m
    ~/.local/bin/bsp-minimize

# bring back a minimized / hidden window
ctrl + alt + h
    hidden-menu

# hide / show all floating windows here
super + i
    ~/.local/bin/bsp-hidefloats

# scratchpad: toggle / add focused / remove focused
super + {_,shift + ,ctrl + }s
    ~/.local/bin/bsp-scratch {toggle,add,remove}

# focus in a direction
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}.local.!hidden.!sticky

# move (tiled: swap, floating: nudge)
super + shift + {Left,Down,Up,Right,h,j,k,l}
    ~/.config/bspwm-wl/bin/wl-smartmove {west,south,north,east,west,south,north,east}

# swap with the neighbour
ctrl + alt + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}.local

# previous / next window
alt + {_,shift + }Tab
    bspc node -f {prev,next}.local.window.!hidden

# window switcher with previews (hold Super, tap Tab; shift: backwards)
super + Tab
    windows next
super + shift + Tab
    windows prev

# raise / lower in the stack
super + shift + {bracketleft,bracketright}
    ~/.local/bin/bsp-stack {raise,lower}

# centre floating window (shift / plus: 50% x 80%)
super + {equal,shift + equal,plus}
    ~/.local/bin/bsp-center {_,fit,fit}

# snap floating window to an edge
super + alt + shift + {Left,Down,Up,Right}
    ~/.local/bin/bsp-edge {west,south,north,east}

# grow / shrink
super + {KP_Add,minus,KP_Subtract}
    ~/.local/bin/bspwm-resize {grow,shrink,shrink}

# grow / shrink around the centre
super + ctrl + {Up,Down,Left,Right}
    ~/.local/bin/bspwm-cresize {shrink v,grow v,shrink h,grow h}

# tiled window bigger / smaller
super + alt + {plus,minus}
    bspc node -z {top_right 20 -20; bspc node -z bottom_left -20 20,top_right -20 20; bspc node -z bottom_left 20 -20}

# floating window bigger / smaller
super + ctrl + {plus,minus}
    xdotool getactivewindow windowmove --relative -- {-50 -25; xdo resize -w +100 -h +50,50 25; xdo resize -w -100 -h -50}

# select parent (repeat to climb) / back down to a window
super + a
    bspc node -f @parent
super + shift + a
    bspc node -f @first.leaf || bspc node -f last.local.leaf

# window groups: toggle / join neighbour / next / previous
super + g
    ~/.local/bin/bsp-group toggle
super + ctrl + shift + {Left,Down,Up,Right}
    ~/.local/bin/bsp-group into {west,south,north,east}
super + ctrl + {_,shift + }Tab
    ~/.local/bin/bsp-group {next,prev}

# ======================================================================
#  layout and preselection
# ======================================================================

# preselect (press again to cancel)
super + alt + {Left,Down,Up,Right}
    bspc node -p ~{west,south,north,east}

# preselect below / cancel
super + ctrl + {v,q}
    bspc node -p {south,cancel}

# cancel preselection (also a pending smart-move)
super + alt + Escape
    bspc node -p cancel; ~/.config/bspwm-wl/bin/wl-smartmove cancel

# move into the preselected spot / clear the selection
super + {Return,shift + Escape}
    ~/.local/bin/bspwm-sel {toggle,clear}

# rotate the split of this window
super + u
    bspc node @parent -R 90

# rotate the whole desktop
super + {_,shift + }r
    bspc node @/ --rotate {90,-90}

# balance
super + ctrl + alt + b
    bspc node @/ -B

# equal columns (alt: rows too)
super + ctrl + {_,alt + }equal
    ~/.config/bspwm-wl/bin/wl-eqcols {_,-r}

# ======================================================================
#  desktops
# ======================================================================

# go to desktop 1-10 / send window there
super + {_,ctrl + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# send window to desktop 1-10 (alt: and follow)
super + {_,alt + }shift + {1-9,0}
    ~/.local/bin/bspwm-sel {send,sendfollow} {1-9,0}

# previous / next desktop
super + {bracketleft,bracketright}
    bspc desktop -f {prev,next}

# previous / next desktop on this monitor
super + {Next,Prior}
    bspc desktop -f {prev,next}.local

# send window left / right (alt: and follow)
super + {_,alt + }shift + {Next,Prior}
    ~/.local/bin/bspwm-sel {shift,shiftfollow} {prev,next}

# last desktop
super + {_,shift + }apostrophe
    bspc desktop -f last

# rename this desktop
super + ctrl + r
    ~/.config/bspwm-wl/bin/wl-rename
