#!/usr/bin/env bash
# llama-local: one local llama.cpp server (OpenAI-compatible) for Neovim / agents.
# Always: 127.0.0.1:8080, model alias "local", --jinja, full Vulkan offload.
# usage: llama-local [start [NAME|PATH]] | NAME|PATH (switch) | stop | restart [NAME|PATH]
#                    | status | list | log
export PATH="$HOME/.guix-profile/bin:/run/current-system/profile/bin:$PATH"
CONF="${LLAMA_LOCAL_CONF:-$HOME/.config/llama-local/models.conf}"
MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/models}"
HOST=127.0.0.1
PORT="${LLAMA_PORT:-8080}"
LOG="$HOME/.local/state/llama-server.log"
CUR="$HOME/.local/state/llama-local.current"
PIDF="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/llama-server.pid"
BIN="$HOME/.guix-profile/bin/llama-server"
THREADS="${LLAMA_THREADS:-8}"

running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
conf_default() { awk '$1=="default"{print $2; exit}' "$CONF" 2>/dev/null; }
# resolve NAME|PATH -> sets M_NAME M_PATH M_CTX M_EXTRA
resolve() {
  local want="${1:-$(conf_default)}" line
  M_EXTRA=
  if [ -f "$want" ]; then M_NAME=$(basename "$want" .gguf); M_PATH=$want; M_CTX=${LLAMA_CTX:-16384}; return 0; fi
  line=$(awk -v n="$want" '$1==n && $1!="default" && $1!~/^#/{print; exit}' "$CONF" 2>/dev/null)
  [ -n "$line" ] || { echo "llama-local: unknown model '$want' (see: llama-local list)" >&2; return 1; }
  read -r M_NAME M_PATH M_CTX M_EXTRA <<<"$line"
  case "$M_PATH" in /*) ;; *) M_PATH="$MODELS_DIR/$M_PATH" ;; esac
  M_CTX=${LLAMA_CTX:-$M_CTX}
  [ -f "$M_PATH" ] || { echo "llama-local: model file missing: $M_PATH" >&2; return 1; }
}
wait_ready() {
  for _ in $(seq 1 180); do
    curl -s -m 1 "http://$HOST:$PORT/health" | grep -q '"ok"' && { echo "ready"; return 0; }
    running || { echo "llama-server exited; see $LOG" >&2; tail -n 15 "$LOG" >&2; return 1; }
    sleep 1
  done
  echo "still loading; check: llama-local status" >&2
}
start() {
  if running; then echo "llama-server already running (pid $(cat "$PIDF"), model $(cat "$CUR" 2>/dev/null)); use: llama-local restart [NAME]"; return 0; fi
  [ -x "$BIN" ] || { echo "llama-server not found: guix install llama-cpp" >&2; return 1; }
  resolve "$1" || return 1
  if curl -s -m 1 "http://$HOST:$PORT/health" >/dev/null 2>&1; then echo "port $PORT already in use by another process" >&2; return 1; fi
  mkdir -p "$(dirname "$LOG")"
  [ -f "$LOG" ] && [ "$(stat -c%s "$LOG")" -gt 10485760 ] && mv -f "$LOG" "$LOG.1"
  echo "=== $(date -u '+%F %T UTC') start $M_NAME ($M_PATH) ctx=$M_CTX" >>"$LOG"
  # shellcheck disable=SC2086
  nohup nice -n 5 "$BIN" -m "$M_PATH" --host "$HOST" --port "$PORT" --alias local \
    -c "$M_CTX" -ngl 99 -fa on -t "$THREADS" --jinja -np 2 --cache-reuse 256 \
    --no-webui --cors-origins localhost --no-cors-credentials $M_EXTRA \
    >>"$LOG" 2>&1 </dev/null &
  echo $! >"$PIDF"; echo "$M_NAME" >"$CUR"
  echo "llama-server started: $M_NAME (pid $!) on http://$HOST:$PORT  ctx=$M_CTX  log $LOG"
  [ -n "$LLAMA_NOWAIT" ] || wait_ready
}
stop() {
  if running; then kill "$(cat "$PIDF")"; for _ in $(seq 20); do running || break; sleep 0.5; done; echo stopped
  else echo "not running"; fi
  rm -f "$PIDF"
}
case "${1:-start}" in
  start)   start "$2" ;;
  stop)    stop ;;
  restart) stop; start "$2" ;;
  status)
    if running; then echo "running: $(cat "$CUR" 2>/dev/null) (pid $(cat "$PIDF")) http://$HOST:$PORT"; else echo "not running"; fi
    printf 'health: '; curl -s -m 2 "http://$HOST:$PORT/health" || printf 'down'; echo
    d=/sys/class/drm/card0/device
    [ -r $d/mem_info_gtt_used ] && echo "GPU mem: VRAM $(( $(cat $d/mem_info_vram_used)/1048576 )) MiB, GTT $(( $(cat $d/mem_info_gtt_used)/1048576 )) MiB" ;;
  list)
    echo "default: $(conf_default)   current: $(running && cat "$CUR" 2>/dev/null || echo none)"
    awk '$1!~/^#/ && NF>=3 && $1!="default"{printf "  %-16s ctx=%-6s %s\n",$1,$3,$2}' "$CONF" ;;
  log)     tail -n 50 -f "$LOG" ;;
  -h|--help|help) sed -n 2,5p "$0" ;;
  *)       stop; start "$1" ;;   # llama-local NAME|PATH  -> switch model
esac
