#!/bin/sh
. "$HOME/.config/rices/current/ui.sh" 2>/dev/null   # RICE_SELECT_BG/FG: menu highlight of the active rice
# bspwm-wl Super+D: one-line dmenu-style launcher matching the X11 rofi bar look
export BEMENU_BACKEND=wayland
exec bemenu-run -p 'RUN' -H 22 --fn 'DejaVu Sans Mono, Symbols Nerd Font Mono 11' \
  --tb '#000000' --tf "${RICE_MENU_TITLE:-#00ff41}" --fb '#000000' --ff '#c0ffc0' \
  --nb '#000000' --nf '#c0ffc0' --ab '#000000' --af '#c0ffc0' \
  --hb "${RICE_SELECT_BG:-#1f6f2f}" --hf "${RICE_SELECT_FG:-#c0ffc0}" --sb '#1f6f2f' --sf '#00ff41' \
  --cb '#00ff41' --cf '#00ff41' --scb '#000000' --scf '#00ff41' \
  --bdr '#000000' -B 0 --hp 8 "$@"
