#!/usr/bin/env bash
# Start both local LLM servers (if not already running). Logs in ~/models/.
pgrep -f "llama-server.*--port 8080" >/dev/null || nohup "$HOME/.local/bin/llm-serve-chat" > "$HOME/models/llm-chat.log" 2>&1 < /dev/null &
pgrep -f "llama-server.*--port 8081" >/dev/null || nohup "$HOME/.local/bin/llm-serve-fim"  > "$HOME/models/llm-fim.log"  2>&1 < /dev/null &
