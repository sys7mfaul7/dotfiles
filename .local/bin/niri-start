#!/bin/sh
# niri session launcher. Separate from bspwm-wl and X11 bspwm.
# Use from LightDM (niri-session package) or from a TTY:  niri-start
[ -r /etc/profile ] && . /etc/profile >/dev/null 2>&1      # system + ~/.guix-profile PATH/XDG_DATA_DIRS
export PATH="$HOME/.local/bin:$HOME/.config/niri/bin:$HOME/.guix-profile/bin:$PATH"
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:${XDG_DATA_DIRS:-/run/current-system/profile/share}"
export XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" GDK_BACKEND="wayland,x11"
export ELECTRON_OZONE_PLATFORM_HINT=auto _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
# DISPLAY is set by niri itself once xwayland-satellite is up (on-demand X11).
unset DISPLAY WAYLAND_DISPLAY BSPWM_SOCKET
N="$HOME/.guix-profile/bin/niri"; [ -x "$N" ] || N=niri
mkdir -p "$HOME/.local/state/niri"
LOG="$HOME/.local/state/niri/session.log"
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  exec dbus-run-session -- "$N" --session "$@" >"$LOG" 2>&1
fi
exec "$N" --session "$@" >"$LOG" 2>&1
