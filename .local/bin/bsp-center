#!/bin/sh
# bsp-center [fit] : center focused floating window; "fit" resizes to 50%w x 80%h
if ! bspc query -N -n focused.floating >/dev/null; then if [ "$1" = fit ]; then bspc node @/ -B; elif bspc query -N -n focused.leaf >/dev/null; then bspc node @parent -B; else bspc node -B; fi; exit 0; fi
eval $(bspc query -T -m focused | jq -r ".rectangle|\"MX=\(.x) MY=\(.y) MW=\(.width) MH=\(.height)\"")
id=$(bspc query -N -n focused)
if [ "$1" = fit ]; then W=$((MW*50/100)); H=$((MH*80/100))
else eval $(bspc query -T -n focused | jq -r ".client.floatingRectangle|\"W=\(.width) H=\(.height)\""); fi
xdotool windowsize $id $W $H windowmove $id $((MX+(MW-W)/2)) $((MY+(MH-H)/2))
