#!/bin/sh
# bsp-pip [--big] [node]: picture-in-picture for the focused window. Pins it
# (floating + sticky, amber border) so it follows you to every desktop, sizes it
# to 1/6 of the monitor width by 1/4 of its height (--big: twice that, 1/3 x 1/2),
# and parks it in the top-right corner with a small gap.
# Bound to Super+Shift+P (--big: Super+Shift+Alt+P) in bspwm-wl and X11 bspwm.
GAP=${PIP_GAP:-12}
SCALE=${PIP_SCALE:-1}
[ "$1" = "--big" ] && { SCALE=2; shift; }
exec 2>>"${XDG_RUNTIME_DIR:-/tmp}/bsp-pip.log"
id=${1:-$(bspc query -N -n focused.window)} || exit 0; [ -n "$id" ] || exit 0
bspc query -N -n "$id.sticky" >/dev/null || "$HOME/.local/bin/bsp-pin" "$id"
bspc query -N -n "$id.floating" >/dev/null || bspc node "$id" -t floating
bspc node "$id" -l above   # always on top
PIP_ID="$id" PIP_GAP="$GAP" PIP_SCALE="$SCALE" python3 - <<'PY'
import json, os, subprocess as sp
nid = os.environ["PIP_ID"]; gap = int(os.environ["PIP_GAP"]); k = int(os.environ["PIP_SCALE"])
q = lambda *a: json.loads(sp.check_output(["bspc", "query", "-T", *a]))
m = q("-m"); r = m["rectangle"]; p = m.get("padding", {})
t = q("-n", nid); c = t["client"]["floatingRectangle"]; b = t["client"].get("borderWidth", 0)
W = r["width"] // 6 * k; H = r["height"] // 4 * k
X = r["x"] + r["width"] - p.get("right", 0) - gap - W - 2 * b
Y = r["y"] + p.get("top", 0) + gap
sp.run(["bspc", "node", nid, "-z", "bottom_right", str(W - c["width"]), str(H - c["height"])])
c = q("-n", nid)["client"]["floatingRectangle"]
sp.run(["bspc", "node", nid, "-v", str(X - c["x"]), str(Y - c["y"])])
PY
