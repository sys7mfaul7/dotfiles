#!/usr/bin/env python3
# bold-text : map ASCII letters/digits to Unicode Mathematical Sans-Serif Bold
# (U+1D5D4..). Used by the bemenu wrapper to bold only the prompt text,
# since bemenu has no separate prompt font. Part of sys7mfaul7 dotfiles.
import sys
def b(s):
    o = []
    for c in s:
        if 'A' <= c <= 'Z': o.append(chr(0x1D5D4 + ord(c) - 65))
        elif 'a' <= c <= 'z': o.append(chr(0x1D5EE + ord(c) - 97))
        elif '0' <= c <= '9': o.append(chr(0x1D7EC + ord(c) - 48))
        else: o.append(c)
    return ''.join(o)
args = sys.argv[1:]
sys.stdout.write(b(' '.join(args)) if args else b(sys.stdin.read()))
