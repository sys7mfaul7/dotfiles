#!/bin/sh
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -r "$XDG_RUNTIME_DIR/dbus-env" ] && . "$XDG_RUNTIME_DIR/dbus-env"
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
APP="$HOME/.local/opt/brave/app"
# Always open a new window on the current workspace (not a tab in an old window)
NW=--new-window
for a in "$@"; do case "$a" in --app*|--new-window|--incognito) NW= ;; esac; done
WL_ARGS=""; WL_FLAGS=""
if [ -n "$WAYLAND_DISPLAY" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
  WL_ARGS="--share=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY --preserve=^WAYLAND_DISPLAY --preserve=^XDG_RUNTIME_DIR wayland"
  WL_FLAGS="--ozone-platform=wayland --enable-features=WaylandWindowDecorations"
fi
exec guix shell --container --emulate-fhs --network --share="$HOME" \
  --share=/tmp --share=/dev/shm --expose="$XAUTHORITY" --share=/dev/dri \
  --preserve=^DISPLAY --preserve=^XAUTHORITY --preserve=^DBUS_SESSION_BUS_ADDRESS --preserve=^GTK_THEME \
  gtk+ nss nspr alsa-lib libxkbcommon mesa libdrm libxscrnsaver libxtst cups at-spi2-core \
  dbus expat libsecret eudev coreutils bash glibc-locales fontconfig font-dejavu font-google-noto-emoji font-google-noto \
  nss-certs libxcomposite libxdamage libxrandr libxext libx11 libxcb libxfixes pango cairo \
  gdk-pixbuf glib libnotify gcc-toolchain libxshmfence pulseaudio xdg-utils $WL_ARGS -- \
  "$APP/brave" --no-sandbox --load-extension="$HOME/.local/share/brave-h4ck3r-theme" --force-dark-mode $WL_FLAGS $NW "$@"
