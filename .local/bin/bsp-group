#!/bin/sh
# Hyprland-ish window groups for bspwm using suckless tabbed.
#  bsp-group toggle        : group focused window / ungroup if focused is a group
#  bsp-group into <dir>    : merge focused window and neighbor in <dir> into one group
#  bsp-group next|prev     : cycle tabs in focused group
is_tabbed() { xprop -id "$1" WM_CLASS 2>/dev/null | grep -q "\"tabbed\""; }
new_group() { tabbed -c -d -n tabbed -p s+1 -o "#0a0e14" -O "#5fbf5f" -t "#1f6f2f" -T "#c0ffc0" -u "#1a2a1f" -U "#2f5a2f" -f "JetBrainsMono Nerd Font:size=11" 2>/dev/null | head -1; }
add() { xdotool windowunmap "$1"; xdotool windowreparent "$1" "$2"; }
ungroup() { for c in $(xwininfo -children -id "$1" | grep -oE "^ +0x[0-9a-f]+" ); do xdotool windowreparent "$c" "$(xwininfo -root | awk "/Window id/{print \$4}")"; done; }
f=$(bspc query -N -n focused) || exit 0
case $1 in
  toggle) if is_tabbed "$f"; then ungroup "$f"; else g=$(new_group); sleep 0.15; add "$f" "$g"; fi ;;
  into) n=$(bspc query -N -n "$2.local.window") || exit 0
        if is_tabbed "$n"; then add "$f" "$n"
        elif is_tabbed "$f"; then add "$n" "$f"
        else g=$(new_group); sleep 0.15; add "$f" "$g"; add "$n" "$g"; fi ;;
  next) is_tabbed "$f" && xdotool key --window "$f" ctrl+shift+l ;;
  prev) is_tabbed "$f" && xdotool key --window "$f" ctrl+shift+h ;;
esac
