#!/bin/sh
# bsp-edge <dir> : snap focused floating window to monitor edge, 10px gap
G=10
bspc query -N -n focused.floating >/dev/null || exit 0
id=$(bspc query -N -n focused)
eval $(bspc query -T -m focused | jq -r ".rectangle|\"MX=\(.x) MY=\(.y) MW=\(.width) MH=\(.height)\"")
TP=$(bspc config top_padding); BP=$(bspc config bottom_padding)
eval $(xdotool getwindowgeometry --shell $id)
B=$(bspc config border_width)
case $1 in
  west)  X=$((MX+G)) ;;
  east)  X=$((MX+MW-WIDTH-2*B-G)) ;;
  north) Y=$((MY+TP+G)) ;;
  south) Y=$((MY+MH-BP-HEIGHT-2*B-G)) ;;
esac
xdotool windowmove $id ${X:-x} ${Y:-y}
